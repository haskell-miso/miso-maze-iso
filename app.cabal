cabal-version:      3.0
name:               miso-maze
version:            0.1.0.0
build-type:         Simple

executable app
  hs-source-dirs:
    src
  main-is:
    client.hs
  other-modules:
    App.Component
    App.Model
    Domain.Game
    Domain.Hero
  build-depends: 
    aeson,
    base,
    containers,
    miso,
    network-uri,
    servant,
    vector
  ghc-options:
    -Wall -O2 -no-hs-main -optl-mexec-model=reactor "-optl-Wl,--export=hs_start" -ddump-splices
  default-language:
    GHC2024
  default-extensions:
    TemplateHaskell

executable server
  hs-source-dirs:
    src
  main-is:
    server.hs
  other-modules:
    App.Component
    App.Model
    Domain.Game
    Domain.Hero
    Server.Api
  build-depends: 
    aeson,
    base,
    containers,
    http-types,
    miso,
    network-uri,
    servant,
    servant-server,
    vector,
    wai,
    wai-app-static,
    wai-extra,
    warp
  ghc-options:
    -Wall -O2 -ddump-splices
  default-language:
    GHC2024
  default-extensions:
    TemplateHaskell

test-suite test
  main-is:
    spec.hs
  hs-source-dirs:
    src
  type:
    exitcode-stdio-1.0
  build-depends:
    base,
    hspec,
    vector
  other-modules:
    Domain.Game
    Domain.GameSpec
  default-language:
    GHC2024
  default-extensions:
    CPP TemplateHaskell
  ghc-options:
    -Wall -O2

